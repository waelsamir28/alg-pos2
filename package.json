{
  "name": "alg-pos2",
  "version": "1.0.0",
  "private": true,
  "description": "نظام نقاط البيع وإدارة المكتبات — نسخة سطح المكتب",
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev-server.js",
    "start": "node --env-file-if-exists=.env scripts/dev-server.js",
    "electron": "electron .",
    "electron:dev": "electron . --dev-url=http://127.0.0.1:3000",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir",
    "check": "node --check app.js && node --check main.js && node --check electron/local-server.js && node --check api/sync.js && node --check lib/data.js && node --check lib/finance.js && node --check lib/barcode.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.1.0"
  },
  "build": {
    "appId": "com.algammal.pos2",
    "productName": "ALG POS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "electron/**/*",
      "index.html",
      "app.js",
      "sw.js",
      "manifest.webmanifest",
      "icon-192.png",
      "icon-512.png",
      "icon-maskable-512.png",
      "lib/**/*",
      "fonts/**/*",
      "api/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ALG POS"
    },
    "portable": {
      "artifactName": "ALG-POS-${version}-portable.exe"
    }
  },
  "author": "ALG"
}
